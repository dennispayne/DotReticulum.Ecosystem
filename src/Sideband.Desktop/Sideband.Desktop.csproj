<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>sideband</AssemblyName>
    <PackageId>Sideband.Desktop</PackageId>
    <RootNamespace>Sideband.Desktop</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sideband.Tests" />
    <ProjectReference Include="..\Sideband\Sideband.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="THIRD-PARTY-NOTICES.Angle.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="THIRD-PARTY-NOTICES.Runtime.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
