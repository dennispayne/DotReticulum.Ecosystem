    {
      "name": "empty-middle",
      "text": "[one]\na = a,,b\n",
      "error": "ParseError"
    },
    {
      "name": "duplicate-key",
      "text": "[one]\na = x\na = y\n",
      "error": "DuplicateError"
    },
    {
      "name": "duplicate-section",
      "text": "[one]\na = x\n[one]\nb = y\n",
      "error": "DuplicateError"
    },
    {
      "name": "bad-depth",
      "text": "[one]\n[[[deep]]]\na = x\n",
      "error": "NestingError"
    },
    {
      "name": "unterminated",
      "text": "[one]\na = \"\"\"first\n",
