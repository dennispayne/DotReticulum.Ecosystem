<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Sideband.Core</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sideband</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Printing\*.cs" Link="Shared\Printing\%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Sideband.Tests" />
    <PackageReference Include="GeographicLib.NET" Version="2.3.2" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <ProjectReference Include="..\LXMF\LXMF.csproj" />
    <ProjectReference Include="..\LXST\LXST.csproj" />
    <ProjectReference Include="..\..\external\DotReticulum\src\DotReticulum.Applications\DotReticulum.Applications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.Markdig.txt" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" Pack="true" PackagePath="" />
    <None Include="THIRD-PARTY-NOTICES.MQTTnet.txt" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" Pack="true" PackagePath="" />
    <None Include="THIRD-PARTY-NOTICES.GeographicLib.txt" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
