<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nomadnet</AssemblyName>
    <RootNamespace>NomadNet</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\Printing\*.cs" Link="Shared\Printing\%(Filename)%(Extension)" />
    <PackageReference Include="System.Formats.Cbor" Version="11.0.0" />
    <ProjectReference Include="..\LXMF\LXMF.csproj" />
    <ProjectReference Include="..\..\external\DotReticulum\src\DotReticulum.Applications\DotReticulum.Applications.csproj" />
    <None Update="ThirdPartyNotices\System.IO.Ports.MIT.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdPartyNotices\System.Formats.Cbor.MIT.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
