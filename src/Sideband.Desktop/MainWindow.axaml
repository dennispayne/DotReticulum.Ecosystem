<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Sideband.Desktop"
        x:Class="Sideband.Desktop.MainWindow"
        x:CompileBindings="True"
        Title="Sideband"
        Width="1040"
        Height="820"
        MinWidth="720"
        MinHeight="620"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="64,*">
    <Border Grid.Row="0" Background="{DynamicResource AccentBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,0">
        <Button x:Name="MenuToggleButton" Width="44" Content="☰" Click="ToggleNavigation"
                Background="Transparent" Foreground="White" />
        <TextBlock x:Name="PageTitle" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                   FontSize="20" FontWeight="SemiBold" Foreground="White" Text="Conversations" />
        <TextBlock x:Name="ToolbarStatusText" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"
                   Foreground="White" Text="Offline" />
        <Button Grid.Column="3" Width="44" Content="×" Click="CloseWindow"
                Background="Transparent" Foreground="White" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <Border x:Name="NavigationPanel" Grid.Column="0" Width="240"
              Background="{DynamicResource NavigationBackgroundBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="12" Spacing="6">
            <TextBlock Margin="8,8,0,4" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource SecondaryTextBrush}" Text="MESSAGES" />
            <Button x:Name="ConversationsNavButton" HorizontalContentAlignment="Left"
                    Content="Conversations" Tag="Conversations" Click="NavigateClicked" />
            <Button x:Name="ContactsNavButton" HorizontalContentAlignment="Left"
                    Content="Contacts" Tag="Contacts" Click="NavigateClicked" />
            <Button x:Name="ObjectsNavButton" HorizontalContentAlignment="Left"
                    Content="Objects" Tag="Objects" Click="NavigateClicked" />
            <Button x:Name="AnnouncesNavButton" HorizontalContentAlignment="Left" Content="Announce Stream"
                    Tag="Announces" Click="NavigateClicked" />
            <TextBlock Margin="8,18,0,4" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource SecondaryTextBrush}" Text="RETICULUM" />
            <Button x:Name="ConnectivityNavButton" HorizontalContentAlignment="Left"
                    Content="Connectivity" Tag="Connectivity" Click="NavigateClicked" />
            <Button x:Name="IdentityNavButton" HorizontalContentAlignment="Left"
                    Content="Backup &amp; Keys" Tag="Identity" Click="NavigateClicked" />
            <Button x:Name="UtilitiesNavButton" HorizontalContentAlignment="Left"
                    Content="Utilities" Tag="Utilities" Click="NavigateClicked" />
            <Button x:Name="RepositoryNavButton" HorizontalContentAlignment="Left" Content="Repository Server"
                    Tag="Utilities" Click="NavigateClicked"
                    ToolTip.Tip="Explicit public HTTPS mirroring is configured in Utilities." />
            <Button x:Name="RemoteNavButton" HorizontalContentAlignment="Left" Content="Remote Commands"
                    Tag="Remote" Click="NavigateClicked" />
            <TextBlock Margin="8,18,0,4" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource SecondaryTextBrush}" Text="APPLICATION" />
            <Button x:Name="PreferencesNavButton" HorizontalContentAlignment="Left"
                    Content="Preferences" Tag="Preferences" Click="NavigateClicked" />
            <Button x:Name="GuideNavButton" HorizontalContentAlignment="Left"
                    Content="Guide" Tag="Guide" Click="NavigateClicked" />
            <Button x:Name="MapNavButton" HorizontalContentAlignment="Left" Content="Situation Map"
                    Tag="Map" Click="NavigateClicked" />
            <Button x:Name="TelemetryNavButton" HorizontalContentAlignment="Left" Content="Telemetry"
                    Tag="Telemetry" Click="NavigateClicked" />
            <Button x:Name="VoiceNavButton" HorizontalContentAlignment="Left" Content="Voice"
                    Tag="Voice" Click="NavigateClicked" />
            <Button HorizontalContentAlignment="Left" Content="Hardware · unavailable"
                    IsEnabled="False" ToolTip.Tip="Hardware configuration is managed by Reticulum outside this app." />
            <Button HorizontalContentAlignment="Left" Content="Plugins · unavailable"
                    IsEnabled="False" ToolTip.Tip="Upstream plugin support is not implemented in this build." />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="1">
        <ScrollViewer x:Name="ConversationsPage" IsVisible="True" Margin="24">
          <Grid ColumnDefinitions="280,*" ColumnSpacing="20" MinHeight="560">
            <StackPanel Grid.Column="0" Spacing="10">
              <TextBlock FontSize="24" FontWeight="SemiBold" Text="Conversations" />
              <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                         Text="Choose a contact or add an LXMF delivery address." TextWrapping="Wrap" />
              <ListBox x:Name="ContactList" MinHeight="260"
                       SelectionChanged="ContactSelectionChanged" />
              <TextBox x:Name="ContactNameBox" PlaceholderText="Contact name" />
              <TextBox x:Name="ContactHashBox" PlaceholderText="LXMF delivery address (32 hex)" />
              <Button Content="Add contact" Click="AddContactClicked" />
            </StackPanel>
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
              <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Messages" />
                <TextBlock x:Name="ConversationPeerText" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" Text="Select a contact" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox x:Name="TrustConversationBox" Content="Trusted contact (include reply tickets)" />
                  <Button x:Name="SaveConversationTrustButton" Content="Save trust" Click="SaveConversationTrustClicked" />
                  <Button x:Name="MarkConversationUnreadButton" Content="Mark unread" Click="MarkConversationUnreadClicked" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Row="1" Spacing="6">
                <ListBox x:Name="MessageList" MinHeight="240" SelectionChanged="MessageSelectionChanged" />
                <Image x:Name="MediaPreview" MaxHeight="240" Stretch="Uniform" IsVisible="False" />
                <TextBlock x:Name="MediaStatusText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="PlayAudioButton" Content="Play selected audio" Click="PlayAudioClicked" />
                  <Button x:Name="StopAudioButton" Content="Stop audio" IsEnabled="False" Click="StopAudioClicked" />
                </StackPanel>
              </StackPanel>
              <TextBox x:Name="MessageBox" Grid.Row="2" AcceptsReturn="True" MinHeight="88"
                       MaxLength="65536" PlaceholderText="Write a text message" />
              <StackPanel Grid.Row="3" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox x:Name="AttachmentKindSelector" Width="140" />
                  <ComboBox x:Name="ImageQualitySelector" Width="170" />
                  <Button x:Name="RecordAudioButton" Content="Record 10 s" Click="RecordAudioClicked" />
                  <Button x:Name="ClearRecordingButton" Content="Discard recording" Click="ClearRecordingClicked" />
                </StackPanel>
                <TextBox x:Name="AttachmentPathBox" PlaceholderText="Optional file, image or Ogg Opus path (up to 2 MiB)" />
                <TextBlock x:Name="RecordingStatusText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox x:Name="AttachmentExportPathBox" MinWidth="180" PlaceholderText="Export selected message to..." />
                  <Button x:Name="SaveAttachmentButton" Content="Save file" Click="SaveAttachmentClicked" />
                  <Button Content="Save image" Click="SaveImageClicked" />
                  <Button Content="Save audio" Click="SaveAudioClicked" />
                  <Button x:Name="SendButton" Content="Send securely" Click="SendClicked" />
                </StackPanel>
                <WrapPanel>
                  <Button x:Name="CreatePaperButton" Content="Create paper text" Margin="0,0,8,6" Click="CreatePaperClicked" />
                  <Button x:Name="ShowPaperButton" Content="Show selected paper" Margin="0,0,8,6" Click="ShowPaperClicked" />
                  <Button x:Name="ExportPaperButton" Content="Export URI" Margin="0,0,8,6" Click="ExportPaperClicked" />
                  <Button x:Name="ExportPaperQrButton" Content="Export QR PNG" Margin="0,0,8,6" Click="ExportPaperQrClicked" />
                </WrapPanel>
                <TextBlock Text="Paper creation saves an encrypted offline text message, not a delivery confirmation. Use the export path above; existing files are never overwritten."
                           TextWrapping="Wrap" />
                <TextBox x:Name="PaperUriBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"
                         PlaceholderText="Selected paper lxm:// URI (copy explicitly)" />
                <local:PaperQrView x:Name="PaperQrPreview" MaxHeight="280" IsVisible="False" />
              </StackPanel>
            </Grid>
          </Grid>
        </ScrollViewer>
        <ScrollViewer x:Name="AnnouncesPage" IsVisible="False" Margin="24">
          <StackPanel Spacing="12">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Announce Stream" />
            <TextBlock Text="The newest 48 unique delivery and propagation announcements, stored locally. Announcing does not create a conversation, confer trust or prove a peer is currently online."
                       TextWrapping="Wrap" />
            <Button x:Name="RefreshAnnouncesButton" Content="Refresh history and cached stamp costs" Click="RefreshAnnouncesClicked" />
            <Button x:Name="AnnounceLocalButton" Content="Announce this identity" Click="AnnounceLocalClicked" />
            <ListBox x:Name="AnnouncesList" MinHeight="220" MaxHeight="360" SelectionChanged="AnnounceSelectionChanged" />
            <TextBlock x:Name="AnnounceDetailsText" Text="Select an announcement." TextWrapping="Wrap" />
            <TextBox x:Name="AnnounceAddressBox" IsReadOnly="True" PlaceholderText="Selected destination address" />
            <WrapPanel>
              <Button x:Name="ConverseAnnounceButton" Content="Start conversation" Click="ConverseAnnounceClicked" Margin="0,0,8,6" />
              <Button x:Name="UseAnnounceNodeButton" Content="Use propagation node" Click="UseAnnounceNodeClicked" Margin="0,0,8,6" />
              <Button x:Name="CopyAnnounceButton" Content="Copy address" Click="CopyAnnounceClicked" Margin="0,0,8,6" />
              <Button x:Name="DeleteAnnounceButton" Content="Delete announcement" Click="DeleteAnnounceClicked" Margin="0,0,8,6" />
            </WrapPanel>
            <TextBlock x:Name="AnnouncesStatusText" Text="Offline history is available without starting Reticulum." TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ContactsPage" IsVisible="False" Margin="24">
          <StackPanel Spacing="12">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Contacts" />
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Contacts added here are stored locally. Discovered LXMF delivery announces are added to this list." TextWrapping="Wrap" />
            <ListBox x:Name="ExpandedContactList" MinHeight="320" />
            <Button x:Name="ClassifyObjectButton" Content="Move selected contact to Objects"
                    HorizontalAlignment="Left" Click="ClassifyObjectClicked" />
            <TextBlock Text="Add a contact from the Conversations screen using its 32-character delivery address." TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ObjectsPage" IsVisible="False" Margin="24">
          <StackPanel Spacing="12">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Objects" />
            <TextBlock Text="Objects retain the same LXMF address, history, trust and request permissions, but are separate from ordinary conversations. Classification does not authenticate a reported position or grant any permission."
                       TextWrapping="Wrap" />
            <ListBox x:Name="ObjectList" MinHeight="280" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="InspectObjectButton" Content="Inspect latest visible telemetry" Click="InspectObjectClicked" />
              <Button x:Name="RestoreObjectButton" Content="Move back to Conversations" Click="RestoreObjectClicked" />
            </StackPanel>
            <TextBlock x:Name="ObjectsStatusText" Text="Classify an existing contact in Contacts." TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="TelemetryPage" IsVisible="False" Margin="24">
          <StackPanel Spacing="10">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Telemetry" />
            <TextBlock Text="Telemetry is off by default. Manual positions/values are operator assertions. Optional Reticulum runtime collection reads your connected node or shared owner's statistics and routing tables, not physical sensors. Sending or authorizing requests may disclose this data. No setting opens GPS, microphone or other hardware."
                       TextWrapping="Wrap" />
            <CheckBox x:Name="TelemetryEnabledBox" Content="Enable telemetry" />
            <CheckBox x:Name="TelemetryRnsTransportBox" Content="Collect connected Reticulum runtime telemetry (60-second cache)" />
            <CheckBox x:Name="TelemetryRnsTransportTablesBox" Content="Include interface names/details and routing tables in outgoing reports (additional disclosure)" />
            <CheckBox x:Name="TelemetryInformationEnabledBox" Content="Include information text" />
            <TextBox x:Name="TelemetryInformationBox" MaxLength="16384" PlaceholderText="Information to disclose" />
            <CheckBox x:Name="TelemetryFixedLocationBox" Content="Include an explicitly supplied fixed location" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="TelemetryLatitudeBox" Width="140" Text="0" PlaceholderText="Latitude" />
              <TextBox x:Name="TelemetryLongitudeBox" Width="140" Text="0" PlaceholderText="Longitude" />
              <TextBox x:Name="TelemetryAltitudeBox" Width="140" Text="0" PlaceholderText="Transmitted altitude (m)" />
            </StackPanel>
            <CheckBox x:Name="TelemetrySendTrustedBox" Content="Include local telemetry in messages to trusted contacts" />
            <CheckBox x:Name="TelemetryReceiveTrustedBox" Content="Accept telemetry only through trusted senders" />
            <CheckBox x:Name="TelemetryDisplayTrustedBox" Content="Display only trusted reported sources (plus this identity)" />
            <CheckBox x:Name="TelemetryRequestsAnyoneBox" Content="Authorize telemetry requests from anyone" />
            <CheckBox x:Name="TelemetryRequestsTrustedBox" Content="Authorize telemetry requests from trusted contacts" />
            <CheckBox x:Name="TelemetryLatestOnlyBox" Content="Requests return only the latest local report" />
            <CheckBox x:Name="TelemetryPropagatedBox" Content="Use propagation for telemetry-only sends and requests" />
            <CheckBox x:Name="TelemetryFallbackBox" Content="Retry failed direct telemetry through propagation" />
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Collector and automatic schedules" />
            <TextBox x:Name="TelemetryCollectorBox" MaxLength="32" PlaceholderText="Collector LXMF delivery hash (optional)" />
            <CheckBox x:Name="TelemetryCollectorEnabledBox" Content="Serve stored reports as a collector" />
            <CheckBox x:Name="TelemetrySendCollectorBox" Content="Automatically send to the configured collector" />
            <CheckBox x:Name="TelemetrySendAllCollectorBox" Content="Include eligible stored reports when sending to collector" />
            <CheckBox x:Name="TelemetryRequestCollectorBox" Content="Automatically request reports from collector" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="TelemetrySendIntervalBox" Width="170" Text="43200" PlaceholderText="Send interval (seconds)" />
              <TextBox x:Name="TelemetryRequestIntervalBox" Width="170" Text="43200" PlaceholderText="Request interval (seconds)" />
            </StackPanel>
            <TextBlock Text="Excluded reported source hashes (one per line)" />
            <TextBox x:Name="TelemetryExcludedBox" AcceptsReturn="True" MaxLength="33000" MinHeight="64" />
            <TextBlock Text="Optional manual sensors: one hexadecimal sensor-id=MessagePack-wire-hex entry per line; time and received provenance cannot be supplied." TextWrapping="Wrap" />
            <TextBox x:Name="TelemetryManualSensorsBox" AcceptsReturn="True" MaxLength="16384" MinHeight="64" />
            <CheckBox x:Name="TelemetryAppearanceBox" Content="Send peer appearance" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="TelemetryIconBox" Width="150" MaxLength="64" Text="account" PlaceholderText="Icon name (not a font asset)" />
              <TextBox x:Name="TelemetryForegroundBox" Width="100" MaxLength="6" Text="000000" PlaceholderText="Text RGB" />
              <TextBox x:Name="TelemetryBackgroundBox" Width="100" MaxLength="6" Text="ffffff" PlaceholderText="Background RGB" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SaveTelemetryButton" Content="Save telemetry settings" Click="SaveTelemetryClicked" />
              <Button x:Name="RefreshLocalTelemetryButton" Content="Prepare local report" Click="RefreshLocalTelemetryClicked" />
              <Button x:Name="RefreshTelemetryButton" Content="Refresh stored reports" Click="RefreshTelemetryClicked" />
            </StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Peer permissions, requests and tracking" />
            <TextBox x:Name="TelemetryPeerBox" MaxLength="32" PlaceholderText="Peer LXMF delivery hash" TextChanged="TelemetryPeerChanged" />
            <CheckBox x:Name="ConversationSendTelemetryBox" Content="Include telemetry in ordinary messages to this saved conversation" />
            <CheckBox x:Name="ConversationAllowTelemetryRequestsBox" Content="Authorize requests from this saved conversation" />
            <Button x:Name="SaveConversationTelemetryButton" Content="Save conversation permissions" Click="SaveConversationTelemetryClicked" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SendTelemetryButton" Content="Send latest" Click="SendTelemetryClicked" />
              <Button x:Name="RequestTelemetryButton" Content="Request reports" Click="RequestTelemetryClicked" />
              <Button x:Name="ShowTelemetryOnMapButton" Content="Show selected location on map" Click="ShowTelemetryOnMapClicked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="TelemetryTrackIntervalBox" Width="160" Text="300" PlaceholderText="Track interval (seconds)" />
              <TextBox x:Name="TelemetryTrackDurationBox" Width="160" Text="3600" PlaceholderText="Track duration (seconds)" />
              <Button x:Name="TrackTelemetryButton" Content="Track peer" Click="TrackTelemetryClicked" />
              <Button x:Name="StopTrackingTelemetryButton" Content="Stop tracking peer" Click="StopTrackingTelemetryClicked" />
            </StackPanel>
            <TextBlock x:Name="TelemetryStatusText" Text="Telemetry off by default." TextWrapping="Wrap" />
            <TextBlock x:Name="TelemetryTrackingText" TextWrapping="Wrap" />
            <TextBlock x:Name="TelemetryReportsSummaryText" TextWrapping="Wrap" />
            <ListBox x:Name="TelemetryReportsList" MinHeight="180" SelectionChanged="TelemetrySelectionChanged" />
            <TextBox x:Name="TelemetryDetailsText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="420" />
            <CheckBox x:Name="ConfirmClearTelemetryBox" Content="Confirm deletion of the selected source's stored reports" />
            <Button x:Name="ClearTelemetryButton" Content="Clear selected source" Click="ClearTelemetryClicked" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="MapPage" IsVisible="False" Margin="24">
          <StackPanel Spacing="10">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Situation Map" />
            <TextBlock Text="Drag to pan; use the mouse wheel or zoom buttons. Locations are peer-reported, not independently verified. Online tile requests disclose the viewed area and your IP address to the provider."
                       TextWrapping="Wrap" />
            <ComboBox x:Name="MapSourceSelector" MinWidth="240" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox x:Name="MapPresetSelector" MinWidth="180" />
              <TextBox x:Name="MapApiKeyBox" Width="220" MaxLength="512" PasswordChar="*"
                       PlaceholderText="Your provider API key (when required)" />
              <Button x:Name="ApplyMapPresetButton" Content="Apply provider (disable online)" Click="ApplyMapPresetClicked" />
            </StackPanel>
            <TextBlock Text="Presets require your own credentials where applicable; none are bundled. Applying a preset revokes online consent. Provider templates and credentials are saved in the private local map view."
                       TextWrapping="Wrap" />
            <CheckBox x:Name="MapOnlineConsentBox" Content="Allow online tiles for this session (off by default)" />
            <TextBox x:Name="MapProviderBox" MaxLength="4096" Text="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                     PlaceholderText="HTTPS tile URL template: {z}/{x}/{y} or {q}" />
            <TextBox x:Name="MapAttributionBox" MaxLength="4096" Text="© OpenStreetMap contributors"
                     PlaceholderText="Required provider attribution" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="MapLatitudeBox" Width="110" Text="0" PlaceholderText="Latitude / Y" />
              <TextBox x:Name="MapLongitudeBox" Width="110" Text="0" PlaceholderText="Longitude / X" />
              <TextBox x:Name="MapZoomBox" Width="70" Text="1" PlaceholderText="Zoom" />
              <Button x:Name="MapGoButton" Content="Go / refresh" Click="MapGoClicked" />
              <Button Content="+" Click="MapZoomInClicked" />
              <Button Content="-" Click="MapZoomOutClicked" />
            </StackPanel>
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
              <local:SituationMap x:Name="MapViewport" Height="420" MaxWidth="1536" HorizontalAlignment="Stretch" />
            </Border>
            <TextBlock x:Name="MapAttributionText" TextWrapping="Wrap" />
            <TextBlock x:Name="MapStatusText" Text="Offline: no online requests without explicit consent." TextWrapping="Wrap" />
            <TextBlock x:Name="MapOverlayStatusText" Text="No reported markers loaded." TextWrapping="Wrap" />
            <TextBlock x:Name="MapDiscoveryStatusText" Text="Connect to inspect the selected Reticulum discovery cache. No autoconnect; cache inspection can prune expired or unauthorized entries." TextWrapping="Wrap" />
            <TextBlock x:Name="MapDiscoveryDetailsText" TextWrapping="Wrap" />
            <WrapPanel>
              <CheckBox x:Name="MapClusterBox" Content="Cluster markers" IsChecked="True" Margin="0,0,12,0" Click="MapOverlaysChanged" />
              <CheckBox x:Name="MapInterfacesBox" Content="Reported and cached discovery interfaces" IsChecked="True" Margin="0,0,12,0" Click="MapOverlaysChanged" />
              <CheckBox x:Name="MapConnectionsBox" Content="Reported connection points" Margin="0,0,12,0" Click="MapOverlaysChanged" />
              <CheckBox x:Name="MapHideBlockedBox" Content="Hide blocked points" Margin="0,0,12,0" Click="MapOverlaysChanged" />
              <CheckBox x:Name="MapOnlyBlockedBox" Content="Only blocked points (this session)" Click="MapOverlaysChanged" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="MapHistorySecondsBox" Width="140" Text="604800" PlaceholderText="History seconds" />
              <Button x:Name="ApplyMapHistoryButton" Content="Apply bounded history window" Click="MapOverlaysChanged" />
            </StackPanel>
            <TextBlock Text="Connection points are reported markers, not measured network links. Click a cluster to zoom or a marker to inspect its reporting peer. Zero coordinates are valid; disabled and stale overlays are removed. Interface discovery is not active."
                       TextWrapping="Wrap" />
            <TextBox x:Name="MapFixedLocationsPathBox" PlaceholderText="Explicit fixed_locations file: LXMF hash, latitude, longitude" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="ImportFixedLocationsButton" Content="Replace local fixed locations" Click="ImportFixedLocationsClicked" />
              <Button x:Name="ClearFixedLocationsButton" Content="Clear local fixed locations" Click="ClearFixedLocationsClicked" />
            </StackPanel>
            <TextBlock x:Name="MapFixedLocationsStatusText" Text="Local overrides only; never transmitted as telemetry or read from a plugin directory automatically." TextWrapping="Wrap" />
            <TextBox x:Name="MbTilesPathBox" PlaceholderText="Stopped/checkpointed raster MBTiles file to import" />
            <Button x:Name="ImportMbTilesButton" Content="Import offline raster map" Click="ImportMbTilesClicked" />
            <Button Content="Clear downloaded tiles (keep imported offline map)" Click="ClearMapCacheClicked" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="VoicePage" IsVisible="False" Margin="24">
          <StackPanel Spacing="12">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Voice" />
            <TextBlock Text="Voice is off by default. Enabling registers your LXST telephone while connected. Only answering an accepted call opens capture; trusted direct push-to-talk can answer automatically when explicitly enabled."
                       TextWrapping="Wrap" />
            <CheckBox x:Name="VoiceEnabledBox" Content="Enable voice while connected" />
            <CheckBox x:Name="VoiceTrustedOnlyBox" Content="Accept calls only from trusted peers" />
            <CheckBox x:Name="VoiceDirectPttBox" Content="Allow trusted conversations with direct-PTT permission to answer automatically" />
            <CheckBox x:Name="VoiceHdxSpeakerBox" Content="Use loudspeaker for half-duplex calls" />
            <TextBox x:Name="VoiceMicrophoneBox" MaxLength="512" PlaceholderText="Microphone device identifier (empty for default)" />
            <TextBox x:Name="VoiceSpeakerBox" MaxLength="512" PlaceholderText="Private output device identifier (empty for default)" />
            <TextBox x:Name="VoiceLoudspeakerBox" MaxLength="512" PlaceholderText="Loudspeaker device identifier (empty for default)" />
            <TextBox x:Name="VoiceRingerBox" MaxLength="512" PlaceholderText="Ringer output device identifier (empty for default)" />
            <Button x:Name="ListVoiceDevicesButton" Content="List available devices (does not capture)" Click="ListVoiceDevicesClicked" />
            <TextBox x:Name="VoiceDevicesText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
            <Button x:Name="SaveVoiceButton" Content="Save voice settings" Click="SaveVoiceClicked" />
            <TextBlock x:Name="VoiceStatusText" Text="Voice disabled." TextWrapping="Wrap" />
            <TextBox x:Name="VoiceIdentityBox" MaxLength="32" PlaceholderText="Peer identity hash (32 hex, not LXMF address)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox x:Name="VoiceProfileSelector" MinWidth="180" />
              <ComboBox x:Name="VoiceModeSelector" MinWidth="150" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="CallIdentityButton" Content="Call identity" Click="CallIdentityClicked" />
              <Button x:Name="CallContactButton" Content="Call selected contact" Click="CallContactClicked" />
              <Button x:Name="AnswerCallButton" Content="Answer" Click="AnswerCallClicked" />
              <Button x:Name="RejectCallButton" Content="Reject" Click="RejectCallClicked" />
              <Button x:Name="HangupCallButton" Content="Hang up" Click="HangupCallClicked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CheckBox x:Name="VoiceMuteMicrophoneBox" Content="Mute microphone" Click="VoiceMuteChanged" />
              <CheckBox x:Name="VoiceMuteSpeakerBox" Content="Mute playback" Click="VoiceMuteChanged" />
              <CheckBox x:Name="VoiceLoudspeakerEnabledBox" Content="Loudspeaker" Click="VoiceLoudspeakerChanged" />
              <Button x:Name="PushToTalkButton" Content="Hold to talk (Space)" />
              <Button x:Name="ApplyVoiceProfileButton" Content="Apply profile/mode" Click="ApplyVoiceProfileClicked" />
            </StackPanel>
            <TextBlock x:Name="VoiceFramesText" TextWrapping="Wrap" />
            <CheckBox x:Name="ConversationDirectPttBox" Content="Allow direct PTT for the selected trusted LXMF contact" />
            <Button x:Name="SaveConversationPttButton" Content="Save selected contact PTT permission" Click="SaveConversationPttClicked" />
            <CheckBox x:Name="VoicePeerTrustedBox" Content="Trust this voice-only identity (an existing LXMF conversation takes precedence)" />
            <Button x:Name="SaveVoicePeerTrustButton" Content="Save identity trust" Click="SaveVoicePeerTrustClicked" />
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Saved voice-only identities" />
            <ListBox x:Name="VoicePeerList" MinHeight="100" SelectionChanged="VoicePeerSelected" />
            <TextBox x:Name="VoicePeerNameBox" MaxLength="80" PlaceholderText="Saved voice-only name (not an authenticated identity)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SaveVoicePeerButton" Content="Save name and voice-only trust" Click="SaveVoicePeerClicked" />
              <Button x:Name="DeleteVoicePeerButton" Content="Delete selected voice-only identity" Click="DeleteVoicePeerClicked" />
            </StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Recent call events" />
            <ListBox x:Name="VoiceHistoryList" MinHeight="140" />
            <Button x:Name="ClearVoiceHistoryButton" Content="Clear call history" Click="ClearVoiceHistoryClicked" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ConnectivityPage" IsVisible="False" Margin="24">
          <StackPanel Spacing="16">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Configuring Connectivity" />
            <Border Padding="18" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
              <StackPanel Spacing="8">
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Connectivity status" />
                <TextBlock x:Name="ConnectivityStatusText" TextWrapping="Wrap"
                           Text="Not connected to Reticulum. Connect to determine the runtime state." />
                <TextBlock x:Name="RuntimeModeText" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Shared-instance state is unknown until a connection is opened." TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Reticulum configuration" />
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Sideband uses the selected Reticulum configuration. It does not create, repair, or overwrite that configuration. Interface settings are managed in Reticulum." TextWrapping="Wrap" />
            <TextBox x:Name="ReticulumConfigBox" PlaceholderText="Reticulum config directory or config file" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SaveConfigButton" Content="Save path" Click="SaveConfigClicked" />
              <Button x:Name="ConnectButton" Content="Connect" Click="ConnectClicked" />
              <Button x:Name="DisconnectButton" Content="Disconnect" IsEnabled="False" Click="DisconnectClicked" />
            </StackPanel>
            <TextBlock x:Name="EffectiveConfigPathText" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="LXMF propagation" />
            <TextBox x:Name="PropagationNodeBox" MaxLength="32" PlaceholderText="32-hex propagation address, or empty for automatic selection" />
            <TextBlock x:Name="ActivePropagationNodeText" TextWrapping="Wrap" Text="No propagation node selected or discovered." />
            <CheckBox x:Name="PropagationDefaultBox" Content="Send through the selected propagation node by default" />
            <CheckBox x:Name="PropagationFallbackBox" Content="Retry failed delivery once through a propagation node known at send time" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SavePropagationButton" Content="Save propagation" Click="SavePropagationClicked" />
              <Button x:Name="SyncMessagesButton" Content="Fetch messages" Click="SyncMessagesClicked" />
              <Button x:Name="CancelSyncButton" Content="Cancel fetch" Click="CancelSyncClicked" />
            </StackPanel>
            <TextBlock x:Name="SyncStatusText" TextWrapping="Wrap"
                       Text="Propagation confirms storage at the node, not delivery to the recipient." />
            <CheckBox x:Name="PeriodicSyncBox" Content="Automatically fetch propagated messages while connected" />
            <CheckBox x:Name="LimitManualFetchBox" Content="Limit messages per manual fetch" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="MaximumFetchMessagesBox" Width="140" Text="3" PlaceholderText="Maximum messages" />
              <Button x:Name="SaveSynchronizationSettingsButton" Content="Save manual limit" Click="SaveSynchronizationSettingsClicked" />
            </StackPanel>
            <TextBlock x:Name="SynchronizationSettingsStatusText" TextWrapping="Wrap"
                       Text="This limit affects the Fetch messages button only. Scheduled fetches remain unlimited." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="SyncIntervalBox" Width="140" Text="43200" PlaceholderText="Interval in seconds" />
              <Button Content="Save schedule" Click="SaveSyncScheduleClicked" />
            </StackPanel>
            <TextBlock x:Name="SyncScheduleStatusText" TextWrapping="Wrap"
                       Text="Scheduled checks run every 60 seconds; the default fetch interval is 12 hours." />
            <Border Padding="18" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
              <StackPanel Spacing="8">
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Connectivity details" />
                <TextBlock Text="On Windows and Linux, Reticulum interfaces are configured in the config file shown above. Use the rnstatus utility with this same configuration to inspect routes and interfaces; Sideband does not claim that a daemon is healthy just because its executable or configuration exists."
                           TextWrapping="Wrap" />
                <TextBlock Text="When connected, the mode shown above is reported by the running Reticulum node: shared client, shared owner, or standalone. Sharing may reuse a compatible local Reticulum owner; this app does not open a second physical interface when it joins as a client."
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="IdentityPage" IsVisible="False" Margin="24">
          <StackPanel Spacing="14">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Backup &amp; Keys" />
            <TextBlock Text="The app uses the Reticulum identity stored under its selected Reticulum configuration. The offline --import-profile command can migrate an upstream profile into a new data directory; this page never displays or exports private keys."
                       TextWrapping="Wrap" />
            <TextBlock x:Name="IdentityHashText" Text="Identity: not available while offline" TextWrapping="Wrap" />
            <TextBlock x:Name="DeliveryHashText" Text="LXMF address: not available while offline" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PreferencesPage" IsVisible="False" Margin="24">
          <StackPanel Spacing="14">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Preferences" />
            <TextBlock Text="Local application preferences are saved in Sideband's own state file; they do not alter Reticulum or upstream Sideband settings."
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold" Text="Display name" />
            <TextBox x:Name="DisplayNameBox" MaxLength="64" PlaceholderText="Name announced to LXMF peers" />
            <TextBlock FontWeight="SemiBold" Text="Appearance" />
            <ComboBox x:Name="ThemeSelector" />
            <Button x:Name="SavePreferencesButton" HorizontalAlignment="Left"
                    Content="Save preferences" Click="SavePreferencesClicked" />
            <TextBlock x:Name="PreferencesStatusText" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Incoming LXMF stamps" />
            <CheckBox x:Name="RequireStampsBox" Content="Advertise an inbound stamp cost" />
            <TextBox x:Name="InboundStampCostBox" MaxLength="11" PlaceholderText="Cost 1–254; empty or below one clears the cost" />
            <CheckBox x:Name="RejectInvalidStampsBox" Content="Discard incoming messages with invalid or missing required stamps" />
            <TextBlock Text="Advertising a cost and discarding invalid stamps are independent. Disabling advertisement retains the configured cost. Stamp checks do not replace sender authorization."
                       TextWrapping="Wrap" />
            <Button x:Name="SaveStampPolicyButton" Content="Save stamp policy" HorizontalAlignment="Left" Click="SaveStampPolicyClicked" />
            <TextBlock x:Name="StampPolicyStatusText" TextWrapping="Wrap" />
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Incoming transfer size" />
            <CheckBox x:Name="LimitIncomingMessagesBox" Content="Limit incoming LXMF transfers to 1 MB (1,000,000 bytes)" />
            <TextBlock Text="Disabling this limit permits transfers up to 128 MB (128,000,000 bytes). This is a per-transfer network limit, not a change to attachment composition or local storage bounds. Already admitted transfers are not interrupted."
                       TextWrapping="Wrap" />
            <Button x:Name="SaveDeliverySettingsButton" Content="Save delivery limit" HorizontalAlignment="Left" Click="SaveDeliverySettingsClicked" />
            <TextBlock x:Name="DeliverySettingsStatusText" TextWrapping="Wrap" />
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Upstream settings exchange" />
            <TextBlock Text="JSON settings exchange applies the documented display, propagation, stamp, voice and telemetry subset. Other keys are retained and reported, not activated. Identity and SQLite migration use the separate offline --import-profile command. Disconnect before importing settings."
                       TextWrapping="Wrap" />
            <TextBox x:Name="SettingsExchangePathBox" PlaceholderText="Settings JSON file path" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="ImportSettingsButton" Content="Import settings" Click="ImportSettingsClicked" />
              <Button x:Name="ExportSettingsButton" Content="Export settings" Click="ExportSettingsClicked" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="RemotePage" IsVisible="False" Margin="24">
          <StackPanel Spacing="12">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Remote Commands" />
            <TextBlock Text="Commands use signed LXMF messages. ping, echo TEXT and sig are built in. Other text requests a plugin on the remote peer; no local Python or shell code runs. Remote authorization is required. Replies appear as ordinary conversation messages."
                       TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold" Text="Incoming request authorization (shared with telemetry)" />
            <CheckBox x:Name="RemoteRequestsAnyoneBox" Content="Allow requests from anyone" />
            <CheckBox x:Name="RemoteRequestsTrustedBox" Content="Otherwise allow only trusted conversations" />
            <CheckBox x:Name="RemoteIgnoreUnknownBox" Content="Ignore messages and requests from unknown conversations" />
            <TextBlock Text="Allow anyone overrides trusted-only. Otherwise trusted-only overrides individual conversation permissions. With both off, explicit conversation permission is required. Telemetry collection is not enabled by these controls."
                       TextWrapping="Wrap" />
            <Button x:Name="SaveRemoteAuthorizationButton" Content="Save request policy" HorizontalAlignment="Left" Click="SaveRemoteAuthorizationClicked" />
            <TextBox x:Name="RemoteCommandPeerBox" MaxLength="32" PlaceholderText="Remote LXMF delivery address (32 hex)"
                     TextChanged="RemotePeerChanged" />
            <TextBlock x:Name="RemoteConversationPolicyText" TextWrapping="Wrap" />
            <CheckBox x:Name="RemoteConversationRequestsBox" Content="Allow requests from this saved conversation" />
            <Button x:Name="SaveRemoteConversationButton" Content="Save conversation permission" HorizontalAlignment="Left" Click="SaveRemoteConversationClicked" />
            <TextBox x:Name="RemoteCommandBox" MaxLength="4096" AcceptsReturn="True" MinHeight="64"
                     PlaceholderText="ping, echo TEXT, sig, or a remote plugin request" />
            <CheckBox x:Name="RemotePropagatedBox" Content="Use the selected propagation node (storage is not recipient delivery)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SendRemoteCommandButton" Content="Send command" Click="SendRemoteCommandClicked" />
              <Button x:Name="CancelRemoteCommandsButton" Content="Cancel this window's queued commands" Click="CancelRemoteCommandsClicked" />
            </StackPanel>
            <TextBlock x:Name="RemoteStatusText" Text="Offline. Sending requires an explicit Reticulum connection." TextWrapping="Wrap" />
            <TextBlock Text="Latest 50 conversation messages, including command delivery state and replies. Unsent command work is not replayed after restart."
                       TextWrapping="Wrap" />
            <ListBox x:Name="RemoteHistoryList" MinHeight="180" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="UtilitiesPage" IsVisible="False" Margin="24">
          <StackPanel Spacing="14">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Utilities" />
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Import a paper message" />
            <TextBlock Text="Paste an lxm:// URI and explicitly import while connected. A nonlocal envelope is not authenticated and is not forwarded. Accepted local messages use normal signature validation and duplicate-aware history; no camera or automatic clipboard access."
                       TextWrapping="Wrap" />
            <TextBox x:Name="PaperImportBox" MaxLength="2954" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                     PlaceholderText="lxm://..." />
            <Button x:Name="ImportPaperButton" Content="Import paper URI" HorizontalAlignment="Left" Click="ImportPaperClicked" />
            <TextBlock x:Name="PaperImportStatusText" TextWrapping="Wrap" />
            <TextBlock Text="Use the Connectivity screen for the effective Reticulum config path and rnstatus guidance."
                       TextWrapping="Wrap" />
            <TextBlock Text="The local HTTPS mirror shares files without authentication, not over Reticulum. Use a dedicated public directory containing only files you are authorized to distribute. Never select your profile, private keys or a directory writable by untrusted users. No software or upstream assets are bundled or automatically downloaded."
                       TextWrapping="Wrap" />
            <TextBox x:Name="RepositoryRootBox" PlaceholderText="Dedicated public mirror directory" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="RepositoryBindBox" Width="200" Text="127.0.0.1" PlaceholderText="Listen IP address" />
              <TextBox x:Name="RepositoryPortBox" Width="100" Text="4444" PlaceholderText="TLS port" />
            </StackPanel>
            <TextBlock Text="Loopback is the safe default. A LAN address or 0.0.0.0 exposes the mirror to reachable peers and may require firewall changes. The self-signed certificate is not automatically trusted; verify its SHA-256 fingerprint independently."
                       TextWrapping="Wrap" />
            <CheckBox x:Name="RepositoryConsentBox" Content="I authorize unauthenticated access to this public directory for this session" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="StartRepositoryButton" Content="Start HTTPS mirror" Click="StartRepositoryClicked" />
              <Button x:Name="StopRepositoryButton" Content="Stop mirror" Click="StopRepositoryClicked" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="RepositoryStatusText" Text="Stopped. Nothing is shared until explicitly started." TextWrapping="Wrap" />
            <TextBox x:Name="RepositoryFingerprintText" IsReadOnly="True" PlaceholderText="Running certificate SHA-256" />
            <TextBlock Text="The ecosystem's Reticulum-hosted rngit tools are separate and are not started or configured here."
                       TextWrapping="Wrap" />
            <Button Content="Open Connectivity" HorizontalAlignment="Left" Click="OpenConnectivityClicked" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="GuidePage" IsVisible="False" Margin="24">
          <StackPanel Spacing="14">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Guide" />
            <TextBlock Text="Connect using a Reticulum configuration you control, then add a contact by LXMF delivery address. Messages are sent through the .NET Reticulum and LXMF implementations."
                       TextWrapping="Wrap" />
            <TextBlock Text="Before connecting, check the selected config path on the Connectivity screen. The default may point to an existing user Reticulum configuration; Sideband never repairs or resets it automatically."
                       TextWrapping="Wrap" />
            <TextBlock Text="This desktop build supports bounded messaging/media, paper text, URI import and URI/QR exports, optional LXST calls, manual and opted-in Reticulum runtime telemetry, reported/cached-discovery map overlays, raster/offline MBTiles maps and an explicitly started local HTTPS mirror. Audio needs separately installed native codecs and operating-system devices. Received media never plays or opens automatically. Python plugins, physical sensor collection and remaining inventory contracts are not available."
                       TextWrapping="Wrap" />
            <Button Content="Open Connectivity" HorizontalAlignment="Left" Click="OpenConnectivityClicked" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="1" VerticalAlignment="Bottom" Margin="260,0,12,8"
               Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False" />
  </Grid>
</Window>
