    {
      "name": "literal-inner-quotes",
      "text": "[section#literal] # comment\nkey'part = unquoted \"quote # comment\n",
      "value": {
        "section#literal": {
          "key'part": "unquoted \"quote"
        }
      },
      "written": "[\"section#literal\"]# comment\nkey'part = unquoted \"quote# comment\n"
    },
    {
      "name": "quoted-lists",
      "text": "# original\nroot = scalar\n[one]\na = \"a,b#c\"\nb = alpha, \"two,#\", 'three'\nc = x,\nd = ,\ne =\n",
      "value": {
        "root": "scalar",
        "one": {
          "a": "a,b#c",
          "b": [
            "alpha",
            "two,#",
            "three"
          ],
          "c": [
            "x"
          ],
          "d": [],
          "e": ""
        }
      },
      "written": "# original\nroot = scalar\n[one]\na = \"a,b#c\"\nb = alpha, \"two,#\", three\nc = x,\nd = ,\ne = \"\"\n"
    },
    {
      "name": "nested-comments",
      "text": "[one] # section\nkey = \"value#not-comment\" # inline\n[[child]]\n\"quoted key\" = literal\\path\n[[[deep]]]\nvalue = yes\n[two]\nvalue = no\n",
      "value": {
        "one": {
          "key": "value#not-comment",
          "child": {
            "quoted key": "literal\\path",
            "deep": {
              "value": "yes"
            }
          }
        },
        "two": {
          "value": "no"
        }
      },
      "written": "[one]# section\nkey = \"value#not-comment\"# inline\n[[child]]\nquoted key = literal\\path\n[[[deep]]]\nvalue = yes\n[two]\nvalue = no\n"
    },
    {
      "name": "multiline",
      "text": "[one]\na = \"\"\"first\n# literal\nlast\"\"\" # tail\nb = '''inline \"\"\" literal'''\n",
      "value": {
        "one": {
          "a": "first\n# literal\nlast",
          "b": "inline \"\"\" literal"
        }
      },
      "written": "[one]\na = '''first\n# literal\nlast'''# tail\nb = inline \"\"\" literal\n"
    },
    {
      "name": "interpolation",
      "text": "base = root\n[DEFAULT]\nfallback = inherited\n[one]\na = %(base)s/%(fallback)s\n[[child]]\nb = %(a)s\n",
      "value": {
        "base": "root",
        "DEFAULT": {
          "fallback": "inherited"
        },
        "one": {
          "a": "root/inherited",
          "child": {
            "b": "root/inherited"
          }
        }
      },
      "written": "base = root\n[DEFAULT]\nfallback = inherited\n[one]\na = %(base)s/%(fallback)s\n[[child]]\nb = %(a)s\n"
    },
    {
      "name": "quoted-sections",
      "text": "[\"a # b\"]\n'key=quoted' = \"value\"\n",
      "value": {
        "a # b": {
          "key=quoted": "value"
        }
      },
      "written": "[\"a # b\"]\nkey=quoted = value\n"
    },
